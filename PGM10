class Node {
    char ch;
    int freq;
    Node left, right;

    Node(char ch, int freq) {
        this.ch = ch;
        this.freq = freq;
        left = right = null;
    }
}

public class HuffmanCoding {

    // Find index of minimum frequency node
    static int findMin(Node[] arr, int size) {
        int minIndex = -1;

        for (int i = 0; i < size; i++) {
            if (arr[i] != null) {
                if (minIndex == -1 || arr[i].freq < arr[minIndex].freq) {
                    minIndex = i;
                }
            }
        }
        return minIndex;
    }

    // Build Huffman Tree
    static Node buildTree(char[] chars, int[] freq, int n) {

        Node[] arr = new Node[2 * n];

        for (int i = 0; i < n; i++) {
            arr[i] = new Node(chars[i], freq[i]);
        }

        int size = n;

        while (true) {

            int min1 = findMin(arr, size);
            if (min1 == -1)
                return null;

            Node left = arr[min1];
            arr[min1] = null;

            int min2 = findMin(arr, size);

            if (min2 == -1)
                return left;      // only one node remains

            Node right = arr[min2];
            arr[min2] = null;

            Node parent = new Node('$', left.freq + right.freq);
            parent.left = left;
            parent.right = right;

            arr[size] = parent;
            size++;
        }
    }

    // Print Huffman Codes
    static void printCodes(Node root, String code) {

        if (root == null)
            return;

        if (root.left == null && root.right == null) {
            System.out.println(root.ch + " : " + code);
            return;
        }

        printCodes(root.left, code + "0");
        printCodes(root.right, code + "1");
    }

    public static void main(String[] args) {

        char chars[] = { 'A', 'B', 'C', 'D', 'E', 'F' };
        int freq[] = { 5, 9, 12, 13, 16, 45 };
        int n = chars.length;

        Node root = buildTree(chars, freq, n);

        System.out.println("Huffman Codes:");
        printCodes(root, "");
    }
}
