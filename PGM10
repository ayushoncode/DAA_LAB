class Node {
    char ch;
    int freq;
    Node left, right;

    Node(char ch, int freq) {
        this.ch = ch;
        this.freq = freq;
        left = right = null;
    }
}

public class HuffmanCoding {

    static Node[] Q = new Node[100]; // Min Heap
    static int heapSize = 0;

    // Swap two nodes
    static void swap(int i, int j) {
        Node temp = Q[i];
        Q[i] = Q[j];
        Q[j] = temp;
    }

    // Heapify Up
    static void heapifyUp(int i) {
        int parent = i / 2;

        while (i > 1 && Q[i].freq < Q[parent].freq) {
            swap(i, parent);
            i = parent;
            parent = i / 2;
        }
    }

    // Insert into Min Heap
    static void insertQ(Node node) {
        heapSize++;
        Q[heapSize] = node;
        heapifyUp(heapSize);
    }

    // Heapify Down
    static void heapifyDown(int i) {
        int left = 2 * i;
        int right = 2 * i + 1;
        int smallest = i;

        if (left <= heapSize && Q[left].freq < Q[smallest].freq)
            smallest = left;

        if (right <= heapSize && Q[right].freq < Q[smallest].freq)
            smallest = right;

        if (smallest != i) {
            swap(i, smallest);
            heapifyDown(smallest);
        }
    }

    // Extract Minimum
    static Node extractMinQ() {
        Node x = Q[1];
        swap(1, heapSize);
        heapSize--;
        heapifyDown(1);
        return x;
    }

    // Build Huffman Tree
    static Node huffman(char[] data, int[] freq, int n) {

        // Insert all leaf nodes
        for (int i = 0; i < n; i++) {
            Node leaf = new Node(data[i], freq[i]);
            insertQ(leaf);
        }

        // Build Huffman Tree
        for (int i = 1; i <= n - 1; i++) {

            Node x = extractMinQ();
            Node y = extractMinQ();

            Node z = new Node('$', x.freq + y.freq);
            z.left = x;
            z.right = y;

            insertQ(z);
        }

        return extractMinQ();
    }

    // Print Huffman Codes
    static void printCodes(Node root, String code) {

        if (root == null)
            return;

        if (root.left == null && root.right == null) {
            System.out.println(root.ch + " : " + code);
            return;
        }

        printCodes(root.left, code + "0");
        printCodes(root.right, code + "1");
    }

    public static void main(String[] args) {

        char[] data = { 'A', 'B', 'C', 'D', 'E', 'F' };
        int[] freq = { 45, 13, 12, 16, 9, 5 };

        int n = data.length;

        Node root = huffman(data, freq, n);

        System.out.println("Huffman Codes:");

        printCodes(root, "");
    }
}
