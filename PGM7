#include <stdio.h>

#define INF 999
#define n 5

int dist[n];
int visited[n];

int ExtractMin(int dist[])
{
    int min = INF;
    int u = -1;

    for (int i = 0; i < n; i++)
    {
        if (visited[i] == 0 && dist[i] < min)
        {
            min = dist[i];
            u = i;
        }
    }

    return u;
}

void dijkstra(int w[n][n], int source)
{
    for (int i = 0; i < n; i++)
    {
        dist[i] = INF;
        visited[i] = 0;
    }

    dist[source] = 0;

    for (int count = 0; count < n - 1; count++)
    {
        int u = ExtractMin(dist);

        if (u == -1)
            break;

        visited[u] = 1;

        for (int v = 0; v < n; v++)
        {
            if (visited[v] == 0 &&
                w[u][v] != INF &&
                dist[u] != INF &&
                dist[u] + w[u][v] < dist[v])
            {
                dist[v] = dist[u] + w[u][v];
            }
        }
    }
}

int main()
{
    int w[n][n] =
    {
        {0,   80,  20, 999, 999},
        {80,   0,  10,  30, 999},
        {20,  10,   0,  90,  60},
        {999, 30,  90,   0,  10},
        {999,999,  60,  10,   0}
    };

    int source = 0;

    dijkstra(w, source);

    printf("Shortest Distances from Vertex %d:\n\n", source);

    for (int i = 0; i < n; i++)
    {
        printf("%d --> %d = %d\n", source, i, dist[i]);
    }

    return 0;
}
