#include<stdio.h>
int parent[100];
int rankArr[100];
// create separate groups
void create(int n){
for(int i=1;i<=n;i++){
    parent[i]=i;
    rankArr[i]=0;
}

}

// find group leader with path compression
int find(int x){
    if(parent[x]!=x){
        parent[x]=find(parent[x]);
    }
    
    return parent[x];
}

// merge two groups using union by rank
void unionSet(int a,int b){
    int roota=find(a);
    int rootb=find(b);
    
    if(roota==rootb){
        return;
    }
    
    if(rankArr[roota]>rankArr[rootb]){
        parent[rootb]=roota;
    }
    else if(rankArr[rootb]>rankArr[roota]){
        parent[roota]=rootb;
    }
    else{
        parent[rootb]=roota;
        rankArr[roota]++;
    }
}
// check if users are in same friend group
void sameGroup(int a,int b){
    if(find(a)==find(b)){
        printf("%d and %d are in same friend group\n", a, b);
        
    }
    else{
         printf("%d and %d are not  in same friend group\n", a, b);
    }
}
int main(){
      int n = 8;

    create(n);

    unionSet(1, 2);
    unionSet(2, 3);
    unionSet(4, 5);
    unionSet(6, 7);
    unionSet(5, 6);

    sameGroup(1, 3);
    sameGroup(4, 7);
    sameGroup(2, 8);

    return 0;
}
