#include <stdio.h>

// Swap two elements
void swap(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Insertion Sort for groups of size <= 5
void sort(int A[], int low, int high)
{
    for (int i = low + 1; i <= high; i++)
    {
        int key = A[i];
        int j = i - 1;

        while (j >= low && A[j] > key)
        {
            A[j + 1] = A[j];
            j--;
        }

        A[j + 1] = key;
    }
}

// Find median of a group
int findMedian(int A[], int low, int n)
{
    sort(A, low, low + n - 1);
    return A[low + n / 2];
}

// Lomuto Partition using given pivot
int partition(int arr[], int s, int e, int pivot)
{
    // Move pivot to the last position
    for (int i = s; i <= e; i++)
    {
        if (arr[i] == pivot)
        {
            swap(&arr[i], &arr[e]);
            break;
        }
    }

    pivot = arr[e];

    int i = s - 1;

    for (int j = s; j < e; j++)
    {
        if (arr[j] <= pivot)
        {
            i++;
            swap(&arr[i], &arr[j]);
        }
    }

    i++;
    swap(&arr[i], &arr[e]);

    return i;
}

// SELECT Algorithm (Median of Medians)
int selectAlgo(int A[], int low, int high, int k)
{
    // Base case
    if (low == high)
        return A[low];

    int n = high - low + 1;

    // Number of groups of 5
    int numGroups = (n + 4) / 5;

    int medians[numGroups];

    // Find median of every group
    for (int i = 0; i < numGroups; i++)
    {
        int start = low + i * 5;
        int size = 5;

        // Last group may have fewer elements
        if (start + 5 > high + 1)
            size = high - start + 1;

        medians[i] = findMedian(A, start, size);
    }

    // Find median of medians
    int pivot;

    if (numGroups == 1)
        pivot = medians[0];
    else
        pivot = selectAlgo(medians, 0, numGroups - 1, (numGroups + 1) / 2);

    // Partition around pivot
    int pos = partition(A, low, high, pivot);

    // Rank of pivot (1-based)
    int rank = pos - low + 1;

    // Check position
    if (k == rank)
        return A[pos];
    else if (k < rank)
        return selectAlgo(A, low, pos - 1, k);
    else
        return selectAlgo(A, pos + 1, high, k - rank);
}

int main()
{
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int A[n];

    printf("Enter elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &A[i]);

    // Median position (1-based)
    int k = (n + 1) / 2;

    int median = selectAlgo(A, 0, n - 1, k);

    printf("\nMedian = %d\n", median);

    return 0;
}
